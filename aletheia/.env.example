# =====================================================================
#  Aletheia — variables d'environnement
#  Copie ce fichier en `.env` et remplis les valeurs.
# =====================================================================

# --- Accès au labo (login) ---
# Mot de passe unique pour entrer dans le tableau de bord.
APP_PASSWORD=change-moi
# Clé secrète pour signer les sessions (mets une longue chaîne aléatoire).
SECRET_KEY=change-moi-aussi-avec-une-longue-chaine-aleatoire

# --- Agents de processus (Modérateur / Expérimentateur / Avocat du diable) ---
# Clé API Anthropic (Claude).  https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Praticiens (modèles via API) ---
# OpenRouter : un seul accès vers des dizaines de modèles, dont des gratuits.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq : inférence très rapide + transcription Whisper (palier gratuit).
# https://console.groq.com/keys
GROQ_API_KEY=
